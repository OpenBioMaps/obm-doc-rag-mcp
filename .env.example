# GitHub Container Registry image elérési útja (pl. saját felhasználó/szervezet)
GHCR_IMAGE=openbiomaps/obm-doc-rag-mcp
IMAGE_TAG=latest

# Kiszolgáló port a gépen
PORT=8000

# MCP szállítási protokoll publikus szerverhez:
# 'streamable-http' -> https://<DOMAIN>/mcp (legújabb MCP HTTP szabvány, pl. VS Code, Cursor, Claude)
# 'sse'             -> https://<DOMAIN>/sse (korábbi SSE szabvány)
OBM_TRANSPORT=streamable-http

