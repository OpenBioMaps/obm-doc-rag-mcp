# GitHub Container Registry image path (e.g., your org/user or openbiomaps)
GHCR_IMAGE=openbiomaps/obm-doc-rag-mcp
IMAGE_TAG=latest

# Host port mapping
PORT=8000

# MCP transport protocol for public server:
# 'streamable-http' -> https://<DOMAIN>/mcp (latest MCP HTTP standard, e.g., VS Code, Cursor, Claude)
# 'sse'             -> https://<DOMAIN>/sse (legacy SSE standard)
OBM_TRANSPORT=streamable-http

